# ── Firebase Client SDK (Next.js) ─────────────────────────────────────────────
# Firebase Console → Project Settings → General → Your apps → Web app → SDK setup
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:abcdef1234567890

# ── Backend API URL (Next.js) ──────────────────────────────────────────────────
# In Docker dev the client reaches the server via the host machine, not the container name.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Firebase Admin SDK (Server) ───────────────────────────────────────────────
# Path inside the Docker container — keep as-is for dev.
# The firebase-credentials.json file (service account) must exist at the project root.
# Download from: Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_CREDENTIALS_PATH=/app/firebase-credentials.json

# ── DeepSeek AI ────────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── CORS ──────────────────────────────────────────────────────────────────────
# Origins the API allows. For production use your real domain.
CORS_ORIGINS=http://localhost:3000

# ── Resend (Email) ────────────────────────────────────────────────────────────
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
RESEND_FROM_EMAIL=onb. <onboarding@resend.dev>

# ── Frontend URL (for invite links in emails) ─────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Stripe (Billing) ──────────────────────────────────────────────────────────
# Get your keys at https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Webhook secret — generated after creating the endpoint in the Stripe dashboard.
# For local testing use: stripe listen --forward-to localhost:8000/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
