        </svg>
      </div>
      <div class="cover-header-right">
        <div class="cover-type-label">Relatório de Análise de Briefing</div>
        <div class="cover-type-date">{{ generated_at }}</div>
      </div>
    </div>

    <div class="cover-rule"></div>

    <div class="cover-eyebrow">Cliente</div>
    <div class="cover-client">{{ client_name }}</div>
    <div class="cover-formname">{{ form_name }}</div>

    <div class="cover-meta">
      <div class="cover-meta-block">
        <div class="cover-meta-label">Recebido em</div>
        <div class="cover-meta-value">{{ submitted_at }}</div>
      </div>
      <div class="cover-meta-block">
        <div class="cover-meta-label">Status</div>
        <div class="cover-meta-value"><span class="status-badge status-{{ header_status | lower | replace(' ', '-') }}">{{ header_status }}</span></div>
      </div>
      <div class="cover-meta-block">
        <div class="cover-meta-label">Classificação</div>
        <div class="cover-meta-value">{{ classificacao_onb }}</div>
      </div>
    </div>

    <div class="cover-spacer"></div>

    <div class="cover-score-hero">
      <div class="cover-score-hero-left">
        <div class="cover-score-hero-label">Score ONB</div>
        <div class="cover-score-hero-class">{{ classificacao_onb }}</div>
      </div>
      <div class="cover-score-hero-right">
        <span class="cover-score-num score-{{ score_level }}">{{ nota_clareza }}</span><span class="cover-score-den">/100</span>
      </div>
    </div>

  </div>

  <div class="cover-footer">
    <span class="cover-footer-left">Relatório Estratégico Confidencial · onb.</span>
    <span class="cover-footer-right">{{ generated_at }}</span>
  </div>
</div>

<div class="headline-card">
  <div class="headline-eyebrow">Impacto Estratégico</div>
  <div class="headline-text">{{ headline }}</div>
</div>

<div class="section">
  <div class="section-label">Diagnóstico Estratégico</div>
  <div class="section-body">{{ visao_geral }}</div>
</div>

<div class="section">
  <div class="section-label">Dor do Cliente</div>
  <div class="section-body">{{ dor_do_cliente }}</div>
</div>

<div class="section">
  <div class="section-label">Potencial de Lucro</div>
  <div class="section-body">{{ potencial_de_lucro }}</div>
</div>

<div class="score-section">
  <div class="score-header">
    <div class="score-label-left">Score ONB</div>
    <div class="score-right">
      <span class="score-number score-{{ score_level }}">{{ nota_clareza }}</span><span class="score-denom">/100</span>
      <div class="score-class">{{ classificacao_onb }}</div>
    </div>
  </div>
  <div class="score-body">
    <div class="score-bar-track">
      <div class="score-bar-fill score-bar-{{ score_level }}" style="width:{{ nota_clareza }}%;"></div>
    </div>
    <div class="score-analysis">{{ analise_tecnica }}</div>
  </div>
</div>

{% if red_flags %}
<div class="section">
  <div class="section-label">Red Flags Estratégicas</div>
  {% for flag in red_flags %}
  <div class="red-flag severity-{{ flag.severidade | lower | replace('é', 'e') }}">
    <div class="red-flag-top">
      <span class="red-flag-title">{{ flag.alerta }}</span>
      <span class="severity-badge">{{ flag.severidade }}</span>
    </div>
    <div class="red-flag-details">
      <div class="red-flag-row"><span class="red-flag-key">Impacto</span><span class="red-flag-val">{{ flag.impactoNoNegocio }}</span></div>
      <div class="red-flag-row"><span class="red-flag-key">Ação</span><span class="red-flag-val">{{ flag.recomendacao }}</span></div>
    </div>
  </div>
  {% endfor %}
</div>
{% endif %}

<div class="section">
  <div class="section-label">Perfil Psicográfico</div>
  <div class="section-body">{{ perfil_psicografico }}</div>
</div>

<div class="section">
  <div class="section-label">Estratégia de Venda</div>
  <div class="section-body">{{ estratega_de_venda }}</div>
</div>

<div class="section">
  <div class="section-label">Kickoff Masterlist</div>
  <div class="kickoff-list">
    {% for q in perguntas_kickoff %}
    <div class="kickoff-item">
      <span class="kickoff-num">{{ loop.index }}</span>
      <span class="kickoff-q">{{ q }}</span>
    </div>
    {% endfor %}
  </div>
</div>

<div class="next-action">
  <div class="next-action-label">Próximo Passo</div>
  <div class="next-action-body">{{ proximo_passo }}</div>
</div>

<div class="footer">
