# ── Backend API URL (Next.js) ──────────────────────────────────────────────────
# In Docker dev the client reaches the server via the host machine, not the container name.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# ── MySQL ────────────────────────────────────────────────────────────────────
# Used by both the `mysql` container (root + app user password) and the server's
# DATABASE_URL, which docker-compose.dev.yml builds from this value.
MYSQL_PASSWORD=change-me-mysql

# ── Auth ─────────────────────────────────────────────────────────────────────
# Signs the JWT access/refresh tokens issued by POST /api/v1/auth/login|register.
# Any long random string — e.g. `openssl rand -hex 32`.
JWT_SECRET=change-me-jwt-secret

# ── MinIO (S3-compatible storage) ───────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# Base URL the *browser* uses to fetch uploaded files (logos, avatars, form
# attachments) — must be reachable from outside Docker, unlike S3_ENDPOINT
# (container-to-container, hardcoded to http://minio:9000 in compose).
S3_PUBLIC_URL=http://localhost:9000

# ── DeepSeek AI (Pro-tier insight analysis) ─────────────────────────────────
DEEPSEEK_API_KEY=

# ── Gemini AI (Agency-tier insight analysis, multimodal) ────────────────────
GEMINI_API_KEY=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Origins the API allows. For production use your real domain.
CORS_ORIGINS=http://localhost:3000

# ── Resend (Email) ────────────────────────────────────────────────────────────
# Get your API key at https://resend.com/api-keys — invites, password reset,
# and LGPD data-export emails all go through here. Leave blank to no-op sending
# (the endpoints still work, they just won't deliver mail).
RESEND_API_KEY=
RESEND_FROM_EMAIL=onb. <onboarding@resend.dev>

# ── Frontend URL (for invite/reset links in emails) ───────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Internal (worker → API Socket.IO bridge) ─────────────────────────────────
# Shared secret so only the ARQ worker can hit /internal/emit/insight-completed.
INTERNAL_SECRET=change-me-internal-secret
